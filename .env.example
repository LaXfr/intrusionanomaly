# Copy these variable names into your local environment as needed.
# Values below are placeholders; do not use them as real credentials.
NII_RAW_DATA_DIR=data/raw
NII_INTERIM_DATA_DIR=data/interim
NII_PROCESSED_DATA_DIR=data/processed
NII_MODEL_ARTIFACT_DIR=models
NII_REPORT_FIGURES_DIR=reports/figures
NII_REPORT_EVALUATION_DIR=reports/evaluation
NII_DATASET_DIRECTORY=CIC-IDS2017
NII_DATASET_NAME=CIC-IDS2017
NII_DATASET_SOURCE_URL=https://www.unb.ca/cic/datasets/ids-2017.html
NII_RECURSIVE_DISCOVERY=true
NII_DATASET_METADATA_DIR=data/interim/metadata
NII_INGESTION_REPORT_DIR=reports/ingestion
NII_EDA_REPORT_DIR=reports/eda
NII_CSV_ENCODING=auto
NII_CHUNK_SIZE=100000
NII_LOADING_STRATEGY=standard
NII_SUPPORTED_FILE_EXTENSIONS=.csv
NII_LABEL_CANDIDATES=Label
NII_RANDOM_SEED=42
NII_LOG_LEVEL=INFO
NII_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/network_intrusion
NII_ENVIRONMENT=development
NII_APP_DEBUG=false
NII_APP_NAME=Network Intrusion Detection & Anomaly Intelligence API
NII_API_HOST=127.0.0.1
NII_API_PORT=8000
NII_API_CORS_ORIGINS=
NII_ALLOW_PUBLIC_BIND=false
NII_UPLOAD_DIR=data/uploads
NII_REPORT_DIR=reports
NII_FEATURE_SCHEMA=configs/feature_schema.json
NII_INTELLIGENCE_CONFIG=configs/intelligence.toml
NII_EXPLAINABILITY_CONFIG=configs/explainability.toml
NII_MAX_UPLOAD_BYTES=52428800
NII_MAX_REQUEST_BYTES=8388608
NII_MAX_ANALYSIS_RECORDS=100
NII_MAX_BATCH_SIZE=500
NII_MAX_JOB_ROWS=100000
NII_JOB_BATCH_SIZE=500
POSTGRES_DB=network_intrusion
POSTGRES_USER=nii
POSTGRES_PASSWORD=replace-with-a-local-development-secret
